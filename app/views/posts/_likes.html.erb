  <div class="pt-3 px-2 flex gap-2" id="post_<%= post.id %>_container" >
                                    <%# post_1_container %>
                                    <%# id is important - Turbo needs to know exactly which part of the page it should update. %>
            <% if current_user.present? %>
                <% if current_user.voted_up_on? post %>
                <%# already liked: clicking will unlike %>
                    <%= link_to post_downvotes_path(post.id), data: {turbo_method: :post, turbo_frame: "post_#{post.id}_container"} do %>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="red" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                        </svg>
                    <% end %>
                <% else %>
                <%# not liked : clicking will like %>
                    <%= link_to post_upvotes_path(post.id), data: {turbo_method: :post, turbo_frame: "post_#{post.id}_container"} do %>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                        </svg>
                    <% end %>
                <% end %>
            
            <% else %>
            <%# no logged in display heart without link %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
            <% end %>
            <%# post - each post from loop %>
            <%# get_likes - method provided by act_as_votable gem retrieves the votes associated with that post %>
            <%# size - count those votes %>
            <%= pluralize post.get_likes.size, "like" %>

        </div>