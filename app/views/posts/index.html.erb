<% @posts.each do |post|%>
    <div class="pb-16">
        <div>
            <%# This line displays the profile photo of the user who created the post, but only if that user has uploaded a photo. %>
            <%# <%= image_tag post.user.photo if post.user.photo.attached? %> 
        </div>
        <div>
            <%= post.user.email.split('@').first%>
        </div>
        <div>
            <%= image_tag post.photo, class: 'w-full max-w-md mb-2 rounded-lg md:max-w-[75%] mb-2' %>
        </div>
        <div class="px-2">
            <%= post.description %>
        </div>
        <%# like button %>

        <%= render partial: "likes", locals: {post: post}%>
      
        <%# button %>
        <div>
            <% if post.user == current_user %>
                <div class="mt-4 flex items-start gap-2">
                <%= link_to 'Edit Post',
                    edit_post_path(post.id),
                    class: 'bg-blue-700 hover:bg-blue-800 text-white font-medium rounded-lg text-sm px-5 py-2.5 focus:ring-4 focus:ring-blue-300 focus:outline-none transition-colors' %>

                <%= button_to 'Delete Post',
                    post_path(post.id),
                    method: :delete,
                    class: 'bg-red-700 hover:bg-red-800 text-white font-medium rounded-lg text-sm px-5 py-2.5 focus:ring-4 focus:ring-red-300 focus:outline-none transition-colors' %>
                </div>
            <% end %>
        </div>   
        <%# comment %>
        <div class="mt-5 px-2">
            <h5 class=" text-lg font-bold mb-2">Comment</h5>
                <% post.comments.each do |comment| %>
                <div class="flex justify-between mb-6 items-center">
                    <div class="flex items-start mb-2 ml-2 gap-3">
                        <p class="font-semibold"><%= comment.user.email.split('@').first %></p>
                        <p><%= comment.text %></p>
                    </div>
                    <%= button_to 'Delete', post_comment_path(post,comment), method: :delete, class: "text-white bg-red-700 hovr:bg-red-800 rounded-lg text-sm px-4.5 py-2"%>
                </div>
                    
                <% end %>
            <div>
                <% if current_user %>
                <%# Comment.new - Creates a new, unsaved Comment object. It doesn't insert anything into the database.It simply provides an object for the form to work with. %>
                    <%= simple_form_for Comment.new, 
                        url: post_comments_path(post), 
                        method: :post do |f| %>

                        <%= f.input :text, label: false , placeholder: 'Add a comment...', input_html: {class: 'mt-2 md:max-w-[50%]'} %>
                        <%= f.submit 'Post', class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800' %>
                    <% end %>
                <% else %>
                    <p class="text-sm text-gray-500 mt-4">
                        <%= link_to 'Log in', login_path , class: 'text-blue-600 font-semibold hover:underline' %> to leave a comment.
                    </p>
                <% end %>
            </div>
          

        </div>
        
    </div>
<% end %>